# can choose multiple sources
FROM video("jko65sx8kalj"),
     folder(92),
     video("xysdfnkdsafd")
WHERE
    (hitter.id = me.id AND myTeammate.name = "Anna Leigh Waters") AND
    hitter.feetToKitchen <= 2.5 AND hitter.feetToKitchen > 0 AND
    (shot.num = 3 OR shot.num = 5) AND
    shot.trajectory.isHitOnSide("right") AND
    shot.isVolley AND
    NOT shot[-1].isVolley = false AND
    shot[2].isVolley = true AND
    min(shot.end.x, shot.start.x) < 11 AND
    rally.num < 10 AND
    rally[1].winner = me.team AND
    game.duration < 300.1 AND
    myOpponent1.name != "Ben Johns" AND
    hittersOpponent2.name != "Ben Johns" AND
    myOpponentLHS.name != "Ben Johns" AND
    hittersOpponentRHS.name != "Ben Johns" AND
    shot.taggedWith("BJ4") # can add tags to shot or range of shots
SHOT CONTEXT BEFORE max(-1 shots, -2secs)  # can have whitespace before unit or not
SHOT CONTEXT AFTER 3secs
ORDER BY shot.hitTime
LIMIT 1000
